# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual env
.venv/
venv/
env/

# Local runtime artefacts
*.log
*.tmp
nohup.out
config.json.tmp

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Persistent personal config (см. config.example.json)
config.json

# Local presets (topic-specific keyword/geo/blocklist sets) — kept out of the
# public repo. Drop a presets.local.json into the folder to activate. See
# presets.example.json for the format.
presets.local.json
*.local.json

# TLS certificates (auto-generated, не должны попадать в репозиторий)
tls/
*.pem
*.key

# Runtime artefacts created at startup — chat history, alerts dedup state,
# Telethon session (contains full Telegram account credentials!), and the
# Claude Code worktree metadata.
*.session
*.session-journal
chat.db
chat.db-wal
chat.db-shm
alerts_state.json
.claude/
