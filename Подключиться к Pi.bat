@echo off
:: Подключение по SSH к Raspberry Pi
:: Чтобы поменять адрес или пользователя — отредактируй переменные ниже.

set "PI_USER=pi"
set "PI_HOST=192.168.0.225"

:: Включаем UTF-8 чтобы кириллица в выводе не крякала
chcp 65001 >nul

title Raspberry Pi (%PI_USER%@%PI_HOST%)

echo ============================================================
echo  Подключение к Raspberry Pi
echo  Хост:        %PI_HOST%
echo  Пользователь: %PI_USER%
echo ============================================================
echo.

ssh %PI_USER%@%PI_HOST%

echo.
echo ============================================================
echo  Соединение закрыто. Окно можно закрыть.
echo ============================================================
pause >nul
