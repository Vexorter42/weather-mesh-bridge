[Unit]
Description=Weather to Heltec Mesh bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# поправь User и пути под себя
User=pi
WorkingDirectory=/home/pi/weather-mesh-bridge
Environment=PYTHONUNBUFFERED=1
Environment=WMB_HOST=0.0.0.0
Environment=WMB_PORT=5000
# HTTPS включён по умолчанию; чтобы вернуться на HTTP, поставь WMB_HTTPS=0
Environment=WMB_HTTPS=1
ExecStart=/home/pi/weather-mesh-bridge/.venv/bin/python /home/pi/weather-mesh-bridge/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
